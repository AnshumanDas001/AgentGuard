# Copy to .env (gitignored) and fill in. Real environment variables take precedence.
# Never put real keys in this file: it is committed.

# Agent model. Provider "openrouter" takes OpenRouter model ids; "anthropic" takes Claude ids
# (e.g. AGENTGUARD_AGENT_PROVIDER=anthropic, AGENTGUARD_AGENT_MODEL=claude-opus-5-5).
AGENTGUARD_AGENT_PROVIDER=openrouter
AGENTGUARD_AGENT_MODEL=anthropic/claude-haiku-5.5
AGENTGUARD_AGENT_EFFORT=medium
AGENTGUARD_MAX_STEPS=20
AGENTGUARD_SANDBOX_IMAGE=agentguard-sandbox:latest
# Comma-separated hosts the http_request tool may reach (subdomains included).
AGENTGUARD_HTTP_ALLOWLIST=example.com
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
